AutoToggle.MouseButton1Click:Connect(function()
	AutoLoopEnabled = not AutoLoopEnabled
	if AutoLoopEnabled then
		AutoToggle.Text = "Auto Loop: ON"
		TweenService:Create(AutoToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 100, 60)}):Play()
		AutoLoopThread = task.spawn(function()
			local iteration = 0
			while AutoLoopEnabled do
				local success, err = pcall(function()
					iteration = iteration + 1
					local char = LocalPlayer.Character
					if char then
						local hrp = char:FindFirstChild("HumanoidRootPart")
						if hrp then
							AutoStatus.Text = string.format("Iteration: %d\nPosition: %.1f, %.1f, %.1f\nTimestamp: %.2f",
								iteration,
								hrp.Position.X, hrp.Position.Y, hrp.Position.Z,
								tick()
							)
						end
					end
				end)
				if not success then
					AutoStatus.Text = "Error: " .. tostring(err)
				end
				task.wait(0.5)
			end
			AutoStatus.Text = "Loop stopped. Total iterations: " .. iteration
		end)
	else
		AutoToggle.Text = "Auto Loop: OFF"
		TweenService:Create(AutoToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
		AutoLoopEnabled = false
