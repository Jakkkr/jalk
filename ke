VisualToggle.MouseButton1Click:Connect(function()
	VisualsEnabled = not VisualsEnabled
	if VisualsEnabled then
		VisualToggle.Text = "Visual Tracker: ON"
		TweenService:Create(VisualToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 100, 60)}):Play()
		VisualConnection = RunService.RenderStepped:Connect(function()
			local success = pcall(function()
				local char = LocalPlayer.Character
				if not char then return end
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj:IsA("Model") and obj ~= char then
						local targetRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
						if targetRoot and targetRoot:IsA("BasePart") then
							local distance = (targetRoot.Position - hrp.Position).Magnitude
							if distance <= 300 then
								local x, y, depth = WorldToScreen(targetRoot.Position)
								if x and y and depth > 0 then
									local tracker = VisualElements[obj]
									if not tracker then
										tracker = CreateTrackerElement(obj)
										VisualElements[obj] = tracker
									end
									tracker.Visible = true
									tracker.Position = UDim2.new(0, x - 40, 0, y - 15)
									tracker.BackgroundColor3 = distance < 50 and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(50, 150, 200)
								end
							end
						end
					end
				end
				
				for obj, tracker in pairs(VisualElements) do
					if not obj or not obj.Parent then
						tracker:Destroy()
						VisualElements[obj] = nil
					else
						local targetRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
						if targetRoot then
							local x, y, depth = WorldToScreen(targetRoot.Position)
							if not x or not y or depth <= 0 then
								tracker.Visible = false
							end
						end
					end
				end
			end)
		end)
		table.insert(ActiveConnections, VisualConnection)
	else
		VisualToggle.Text = "Visual Tracker: OFF"
		TweenService:Create(VisualToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
		if VisualConnection then
			VisualConnection:Disconnect()
			VisualConnection = nil
		end
		for _, tracker in pairs(VisualElements) do
			tracker:Destroy()
		end
		table.clear(VisualElements)
	end
end)

local DragConnection1, DragConnection2, DragConnection3
local Dragging = false
local DragOffset = Vector2.new()

local function StartDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		Dragging = true
		local pos = input.Position
		DragOffset = Vector2.new(MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y) - Vector2.new(pos.X, pos.Y)
	end
end

local function UpdateDrag(input)
	if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local pos = input.Position
		MainFrame.Position = UDim2.new(0, pos.X + DragOffset.X, 0, pos.Y + DragOffset.Y)
	end
end

local function EndDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		Dragging = false
	end
end

DragConnection1 = MainFrame.InputBegan:Connect(StartDrag)
DragConnection2 = UserInputService.InputChanged:Connect(UpdateDrag)
DragConnection3 = UserInputService.InputEnded:Connect(EndDrag)

table.insert(ActiveConnections, DragConnection1)
table.insert(ActiveConnections, DragConnection2)
table.insert(ActiveConnections, DragConnection3)

