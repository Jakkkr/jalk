local function GetNearbyEntities(maxDistance)
	local entities = {}
	local character = LocalPlayer.Character
	if not character then return entities end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return entities end
	local origin = rootPart.Position
	
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= character then
			local targetRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head")
			if targetRoot and targetRoot:IsA("BasePart") then
				local distance = (targetRoot.Position - origin).Magnitude
				if distance <= maxDistance then
					local rayParams = RaycastParams.new()
					rayParams.FilterDescendantsInstances = {character}
					rayParams.FilterType = Enum.RaycastFilterType.Blacklist
					local direction = (targetRoot.Position - origin).Unit * distance
					local result = Workspace:Raycast(origin, direction, rayParams)
					local hasLOS = not result or result.Instance:IsDescendantOf(obj)
					table.insert(entities, {
						Model = obj,
						Position = targetRoot.Position,
						Distance = distance,
						HasLOS = hasLOS
					})
				end
			end
		end
	end
	
	table.sort(entities, function(a, b) return a.Distance < b.Distance end)
	return entities
end

TrackToggle.MouseButton1Click:Connect(function()
	TrackingEnabled = not TrackingEnabled
	if TrackingEnabled then
		TrackToggle.Text = "Object Tracking: ON"
		TweenService:Create(TrackToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 100, 60)}):Play()
		TrackConnection = RunService.Heartbeat:Connect(function()
			local success, result = pcall(function()
				return GetNearbyEntities(500)
			end)
			if success then
				local text = "Nearby Entities (" .. #result .. "):\n"
				for i, ent in ipairs(result) do
					if i > 10 then break end
					text = text .. string.format("[%s] %s | %.1f studs | LOS: %s\n", 
						tostring(i), 
						ent.Model.Name, 
						ent.Distance,
						ent.HasLOS and "YES" or "NO"
					)
				end
				TrackResults.Text = text
			else
				TrackResults.Text = "Error: " .. tostring(result)
			end
		end)
		table.insert(ActiveConnections, TrackConnection)
	else
		TrackToggle.Text = "Object Tracking: OFF"
		TweenService:Create(TrackToggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
		if TrackConnection then
			TrackConnection:Disconnect()
			TrackConnection = nil
		end
		TrackResults.Text = ""
	end
end)

